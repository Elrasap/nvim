return {
    {
        "nvim-treesitter/nvim-treesitter",
        branch = "main",
        lazy = false,
        build = ":TSUpdate",

        config = function()
            vim.opt.runtimepath:append(vim.fn.stdpath("data") .. "/site")
            local ts = require("nvim-treesitter")

            ts.setup({})

            local parsers = {
                "c",
                "lua",
                "rust",
                "bash",
                "go",
                "javascript",
                "typescript",
                "vimdoc",
                "jsdoc",
            }

            ts.install(parsers)

            vim.api.nvim_create_autocmd("FileType", {
                pattern = {
                    "c",
                    "lua",
                    "rust",
                    "bash",
                    "go",
                    "javascript",
                    "typescript",
                    "vim",
                    "help",
                },

                callback = function()
                    pcall(vim.treesitter.start)
                end,
            })
        end,
    },

    {
        "nvim-treesitter/nvim-treesitter-context",
        enabled = false,
    },
}
